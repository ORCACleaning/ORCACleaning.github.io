{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/downloads/Western-Host-2026-11-Issue-23.pdf",
      "destination": "/downloads/Western-Host-2026-11-Issue-1.pdf",
      "permanent": false
    },
    {
      "source": "/issue-1/",
      "destination": "/issues/2026-11/",
      "permanent": false
    },
    {
      "source": "/issue-23/",
      "destination": "/issues/2026-11/",
      "permanent": false
    }
  ]
}
